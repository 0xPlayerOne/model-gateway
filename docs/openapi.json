{
  "openapi": "3.1.0",
  "info": {
    "title": "Model Gateway Catalog API",
    "version": "0.14.10",
    "description": "Discovery and metadata resources for models available through Model Gateway."
  },
  "paths": {
    "/v1/models": {
      "get": {
        "summary": "List routable model IDs",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ModelList"
          }
        }
      }
    },
    "/v1/providers": {
      "get": {
        "summary": "List configured and discoverable providers",
        "parameters": [
          {
            "name": "available",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ProviderList"
          }
        }
      }
    },
    "/v1/auto-models": {
      "get": {
        "summary": "List automatic routing selections",
        "description": "Returns compact route selections by default. Use view=full for benchmark matching and per-million pricing details; each candidate links to its complete catalog model resource.",
        "parameters": [
          {
            "name": "route",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "free",
                "efficient",
                "balanced",
                "frontier"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/View"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/AutoModelRoutes"
          }
        }
      }
    },
    "/v1/rankings": {
      "get": {
        "summary": "List benchmark rankings",
        "parameters": [
          {
            "$ref": "#/components/parameters/Task"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/RankingList"
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Proxy an OpenAI-compatible chat completion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Routable model ID or automatic route alias."
                  },
                  "reasoning_effort": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ]
                  }
                },
                "required": [
                  "model"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OpenAI-compatible completion or event stream.",
            "headers": {
              "XModelGatewayBenchmarkLatencyObserved": {
                "description": "Whether the selected automatic-route benchmark included a usable latency measurement.",
                "schema": {
                  "type": "boolean"
                }
              },
              "XModelGatewayBenchmarkLatencySeconds": {
                "description": "The latency measurement used for selection when one was available.",
                "schema": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Health"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Gateway readiness probe",
        "description": "Returns 200 when the routing database is readable. This is process readiness, not provider credential or catalog readiness; use /health/diagnostics for provider-level status.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Health"
          },
          "503": {
            "$ref": "#/components/responses/Health"
          }
        }
      }
    },
    "/health/diagnostics": {
      "get": {
        "summary": "Readiness diagnostics",
        "description": "Reports per-provider credential presence and catalog freshness without exposing secret values. The gateway status distinguishes a healthy gateway from unavailable provider catalogs or missing credentials.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Diagnostics"
          },
          "503": {
            "$ref": "#/components/responses/Diagnostics"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Fetch this OpenAPI contract",
        "responses": {
          "200": {
            "description": "OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/catalog/models": {
      "get": {
        "summary": "List catalog model resources",
        "parameters": [
          {
            "$ref": "#/components/parameters/Access"
          },
          {
            "$ref": "#/components/parameters/Task"
          },
          {
            "$ref": "#/components/parameters/Provider"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/View"
          },
          {
            "$ref": "#/components/parameters/Variants"
          },
          {
            "$ref": "#/components/parameters/Fields"
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          },
          {
            "$ref": "#/components/parameters/IfModifiedSince"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/CatalogCollection"
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          }
        }
      }
    },
    "/v1/catalog/models/{provider}/{model}": {
      "get": {
        "summary": "Fetch complete catalog model metadata",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Provider namespace returned by the catalog collection."
          },
          {
            "name": "model",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "URI-encoded model identifier returned by the catalog collection."
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          },
          {
            "$ref": "#/components/parameters/IfModifiedSince"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ModelResource"
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Access": {
        "name": "access",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "free",
            "paid",
            "all"
          ],
          "default": "all"
        }
      },
      "Task": {
        "name": "task",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "general",
            "coding",
            "agentic"
          ],
          "default": "general"
        }
      },
      "Provider": {
        "name": "provider",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "View": {
        "name": "view",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary"
        }
      },
      "Variants": {
        "name": "variants",
        "in": "query",
        "description": "Use all reasoning-effort benchmark variants instead of one variant per provider/model.",
        "schema": {
          "type": "string",
          "enum": [
            "collapsed",
            "all"
          ],
          "default": "collapsed"
        }
      },
      "Fields": {
        "name": "fields",
        "in": "query",
        "description": "Optional comma-separated allowlist of exact top-level fields to return for each catalog item. Without fields, view selects the default summary or full representation. With fields, the requested allowlisted fields are returned exactly. Projection does not change filtering, ranking, pagination, or snapshot cursors; equivalent field orderings are canonicalized for stable links and ETags.",
        "schema": {
          "type": "string",
          "example": "id,links,quality,reasoning_effort"
        }
      },
      "IfNoneMatch": {
        "name": "If-None-Match",
        "in": "header",
        "description": "Return 304 when the current representation matches the supplied entity tag. Weak comparison and the wildcard are supported for GET.",
        "schema": {
          "type": "string"
        }
      },
      "IfModifiedSince": {
        "name": "If-Modified-Since",
        "in": "header",
        "description": "Return 304 when the representation has not changed since this HTTP date. Ignored when If-None-Match is supplied.",
        "schema": {
          "type": "string",
          "format": "http-date"
        }
      }
    },
    "responses": {
      "ModelList": {
        "description": "OpenAI-compatible list of routable model IDs.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ModelList"
            }
          }
        }
      },
      "CatalogCollection": {
        "description": "Snapshot-consistent catalog collection.",
        "headers": {
          "ETag": {
            "$ref": "#/components/headers/ETag"
          },
          "Last-Modified": {
            "$ref": "#/components/headers/LastModified"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CatalogCollection"
            }
          }
        }
      },
      "ModelResource": {
        "description": "Complete catalog model resource.",
        "headers": {
          "ETag": {
            "$ref": "#/components/headers/ETag"
          },
          "Last-Modified": {
            "$ref": "#/components/headers/LastModified"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ModelResourceResponse"
            }
          }
        }
      },
      "NotModified": {
        "description": "The representation has not changed. The response has no body.",
        "headers": {
          "ETag": {
            "$ref": "#/components/headers/ETag"
          },
          "Last-Modified": {
            "$ref": "#/components/headers/LastModified"
          }
        }
      },
      "Error": {
        "description": "Typed API error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Diagnostics": {
        "description": "Provider readiness diagnostics",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "ready",
                    "not_ready"
                  ]
                },
                "gateway": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "providers_configured": {
                      "type": "integer"
                    },
                    "providers_with_credentials": {
                      "type": "integer"
                    },
                    "providers_with_fresh_catalogs": {
                      "type": "integer"
                    }
                  }
                },
                "provider_catalogs": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "available",
                        "partial",
                        "unavailable",
                        "not_configured",
                        "unknown"
                      ]
                    },
                    "fresh": {
                      "type": "integer"
                    },
                    "configured": {
                      "type": "integer"
                    }
                  }
                },
                "benchmarks": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "available",
                        "stale",
                        "unavailable",
                        "unknown"
                      ]
                    },
                    "snapshots": {
                      "type": "integer"
                    }
                  }
                },
                "providers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "credential": {
                        "type": "string",
                        "enum": [
                          "present",
                          "blank",
                          "missing",
                          "not_required"
                        ]
                      },
                      "credential_source": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "catalog": {
                        "type": "string",
                        "enum": [
                          "fresh",
                          "stale",
                          "missing"
                        ]
                      },
                      "available": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "headers": {
      "ETag": {
        "description": "Strong representation validator.",
        "schema": {
          "type": "string"
        }
      },
      "LastModified": {
        "description": "Catalog data modification time.",
        "schema": {
          "type": "string",
          "format": "http-date"
        }
      }
    },
    "schemas": {
      "ModelList": {
        "type": "object",
        "required": [
          "object",
          "data"
        ],
        "properties": {
          "object": {
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelIdentifier"
            }
          }
        }
      },
      "ModelIdentifier": {
        "type": "object",
        "required": [
          "id",
          "object"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "model"
          },
          "owned_by": {
            "type": "string"
          }
        }
      },
      "ModelResource": {
        "type": "object",
        "required": [
          "id",
          "object",
          "links"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "model"
          },
          "links": {
            "$ref": "#/components/schemas/Links"
          },
          "model": {
            "type": "object"
          },
          "benchmarks": {
            "$ref": "#/components/schemas/BenchmarkMetrics"
          },
          "capabilities": {
            "type": [
              "object",
              "null"
            ]
          },
          "price_per_million": {
            "type": "object"
          },
          "access": {
            "type": "object"
          }
        }
      },
      "ProviderList": {
        "type": "object",
        "required": [
          "object",
          "data"
        ],
        "properties": {
          "object": {
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "AutoModelRoutes": {
        "type": "object",
        "properties": {
          "object": {
            "const": "auto_models"
          },
          "view": {
            "type": "string",
            "enum": [
              "summary",
              "full"
            ]
          },
          "routes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/AutoModelRoute"
            }
          }
        }
      },
      "AutoModelRoute": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "quality_floor": {
            "type": "number"
          },
          "latency_observed": {
            "type": "boolean",
            "description": "Whether any eligible benchmark candidate has a usable latency measurement."
          },
          "primary": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AutoModelCandidate"
              },
              {
                "type": "null"
              }
            ]
          },
          "fallbacks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AutoModelCandidate"
            }
          }
        }
      },
      "AutoModelCandidate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "links": {
            "$ref": "#/components/schemas/Links"
          },
          "quality": {
            "type": [
              "number",
              "object"
            ]
          },
          "reasoning_effort": {
            "type": [
              "string",
              "null"
            ]
          },
          "latency_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "latency_available": {
            "type": "boolean"
          },
          "expected_cost_microusd": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Effective request cost in microdollars; zero for included subscription/free access."
          },
          "reference_cost_microusd": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Reference scarcity cost used for quota-limited or included access."
          },
          "estimated_cost_microusd": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cost_source": {
            "type": "string",
            "enum": [
              "artificial_analysis_task",
              "token_price_scenario",
              "unknown"
            ]
          },
          "benchmark_cost_per_task_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "benchmark_as_of": {
            "type": [
              "string",
              "null"
            ],
            "description": "Source-published benchmark revision date; null when the source did not provide one."
          },
          "time_to_first_answer_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "end_to_end_response_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "output_tokens_per_second": {
            "type": [
              "number",
              "null"
            ]
          },
          "output_tokens_per_task": {
            "type": [
              "integer",
              "null"
            ],
            "maximum": 9223372036854776000,
            "description": "Measured average output size for the benchmark task."
          },
          "pricing_eligible": {
            "type": "boolean"
          },
          "benchmark_match": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "exact",
              "configured",
              "approved",
              "suggested",
              "ambiguous",
              "unmatched",
              null
            ]
          },
          "access": {
            "type": "object"
          },
          "price_per_million": {
            "type": [
              "object",
              "null"
            ]
          },
          "reference_price_per_million": {
            "type": "object"
          }
        }
      },
      "RankingEntry": {
        "type": "object",
        "required": [
          "rank",
          "id",
          "scores",
          "cost_source",
          "latency_available",
          "reasoning_effort",
          "as_of"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "id": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "scores": {
            "type": "object",
            "properties": {
              "intelligence": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "coding": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "agentic": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "input_price_per_million": {
            "type": [
              "number",
              "null"
            ]
          },
          "output_price_per_million": {
            "type": [
              "number",
              "null"
            ]
          },
          "cache_read_price_per_million": {
            "type": [
              "number",
              "null"
            ]
          },
          "cache_write_price_per_million": {
            "type": [
              "number",
              "null"
            ]
          },
          "cost_per_task_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "cost_source": {
            "type": "string",
            "enum": [
              "measured",
              "unavailable"
            ]
          },
          "latency_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "latency_available": {
            "type": "boolean"
          },
          "time_to_first_answer_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "end_to_end_response_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "output_tokens_per_second": {
            "type": [
              "number",
              "null"
            ]
          },
          "output_tokens_per_task": {
            "type": [
              "integer",
              "null"
            ],
            "maximum": 9223372036854776000,
            "description": "Measured average output size for the benchmark task."
          },
          "reasoning_effort": {
            "type": [
              "string",
              "null"
            ]
          },
          "as_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "release_date": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "RankingList": {
        "type": "object",
        "required": [
          "object",
          "data"
        ],
        "properties": {
          "object": {
            "const": "benchmark.rankings"
          },
          "task": {
            "type": "string",
            "enum": [
              "general",
              "coding",
              "agentic"
            ]
          },
          "max_age_seconds": {
            "type": "integer"
          },
          "snapshots": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RankingEntry"
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "ready",
              "not_ready"
            ]
          }
        }
      },
      "ModelResourceResponse": {
        "type": "object",
        "required": [
          "id",
          "object",
          "links",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "model"
          },
          "links": {
            "$ref": "#/components/schemas/Links"
          },
          "data": {
            "$ref": "#/components/schemas/ModelResource"
          },
          "meta": {
            "type": "object"
          }
        }
      },
      "CatalogCollection": {
        "type": "object",
        "required": [
          "object",
          "data",
          "meta",
          "links"
        ],
        "properties": {
          "object": {
            "const": "model.collection"
          },
          "data": {
            "type": "array",
            "items": {
