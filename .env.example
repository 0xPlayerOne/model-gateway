# The gateway does not load dotenv files itself. The convenience scripts source
# .env.local and export these values before starting the gateway.
# Any recognized provider API key automatically activates that provider; setup
# is not required.

# ── Server ──────────────────────────────────────────────────────────────────
# MODEL_GATEWAY_BIND=127.0.0.1:8008
# MODEL_GATEWAY_EXPOSURE=loopback            # loopback or local_container
# MODEL_GATEWAY_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
# MODEL_GATEWAY_LOCAL_MODEL=
# MODEL_GATEWAY_STATE_PATH=$HOME/.config/model-gateway/routing.sqlite3
# MODEL_GATEWAY_LOCAL_MODEL_CACHE_SECONDS=60
# MODEL_GATEWAY_CATALOG_MAX_AGE_SECONDS=86400
# MODEL_GATEWAY_BENCHMARK_MAX_AGE_SECONDS=604800
# MODEL_GATEWAY_PRICING_MAX_AGE_SECONDS=604800
# MODEL_GATEWAY_MAX_BODY_BYTES=33554432
# MODEL_GATEWAY_MAX_IN_FLIGHT=64
# MODEL_GATEWAY_ADMISSION_TIMEOUT_MS=250
# MODEL_GATEWAY_SHUTDOWN_GRACE_SECONDS=30

# ── Routing Modes ───────────────────────────────────────────────────────────
# MODEL_GATEWAY_AUTO_FREE_ENABLED=true
# MODEL_GATEWAY_AUTO_EFFICIENT_ENABLED=true
# MODEL_GATEWAY_AUTO_BALANCED_ENABLED=true
# MODEL_GATEWAY_AUTO_FRONTIER_ENABLED=true

# Quality floors for each routing mode (0-100). Higher floors select
# higher-quality models. The Pareto frontier picks the most efficient model
# above the floor (best quality/cost/latency tradeoff).
# MODEL_GATEWAY_EFFICIENT_QUALITY_FLOOR=35.0
# MODEL_GATEWAY_BALANCED_QUALITY_FLOOR=42.0
# MODEL_GATEWAY_FRONTIER_QUALITY_FLOOR=52.0

# ── Free Models Quality Bar ─────────────────────────────────────────────────
# Filters low-quality, stale, or expensive models from /v1/free-models and
# auto-free routing. Set to 0 to disable a filter.
# MODEL_GATEWAY_FREE_QUALITY_MIN_COMPOSITE=30.0
# MODEL_GATEWAY_FREE_QUALITY_MIN_CONTEXT=8192
# MODEL_GATEWAY_FREE_QUALITY_MIN_MODEL_SIZE=27
# MODEL_GATEWAY_FREE_QUALITY_MAX_AGE_MONTHS=18
# MODEL_GATEWAY_FREE_QUALITY_MAX_INPUT_PRICE=2.0
# MODEL_GATEWAY_FREE_QUALITY_MAX_OUTPUT_PRICE=10.0

# ── Model Denylist ───────────────────────────────────────────────────────────
# Comma-separated list of model IDs to block across all providers.
# MODEL_GATEWAY_MODEL_DENYLIST=model-a,model-b

# ── REQUIRED: Artificial Analysis API key ───────────────────────────────────
# Must add a free API key to use benchmarks for routing.
# ARTIFICIAL_ANALYSIS_API_KEY=

# ── Provider API Keys ───────────────────────────────────────────────────────
# Any recognized provider API key automatically activates that provider.
# See gateway.core.example.toml, gateway.secondary.example.toml, and
# gateway.optional.example.toml for the full reference with defaults.

# CORE: highly encouraged providers. Good free limits or paid plans.
# GOOGLE_API_KEY=
# KILOCODE_API_KEY=
# OLLAMA_API_KEY=
# OPENCODE_API_KEY=
# OPENROUTER_API_KEY=

# LOCAL OAUTH SIDECAR: normally generated by `model-gateway cli-proxy setup`.
# CLI_PROXY_API_KEY=
# MODEL_GATEWAY_CLI_PROXY_HOME=~/.config/model-gateway/cli-proxy
# MODEL_GATEWAY_CLI_PROXY_BINARY=/path/to/cli-proxy-api
# MODEL_GATEWAY_CLI_PROXY_CONFIG=/path/to/config.yaml
# MODEL_GATEWAY_CLI_PROXY_AUTH_DIR=/path/to/auth

# SECONDARY: optional, additional free providers.
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# NOUS_PORTAL_API_KEY=
# NVIDIA_NIM_API_KEY=
# SILICON_FLOW_API_KEY=

# OPTIONAL PAID: only configure if you have a subscription or credits.
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# FIREWORKS_API_KEY=
# OPENAI_API_KEY=
# ORCAROUTER_API_KEY=
# ZAI_API_KEY=

# ── Provider Environment Overrides ──────────────────────────────────────────
# Per-provider billing mode override. Set to paid or subscription for providers
# that require explicit authorization. Multiple providers can be listed as a
# comma-separated list.
# MODEL_GATEWAY_PAID_BILLING_MODE=openai,deepseek,fireworks
# MODEL_GATEWAY_OPENCODE_ZEN_BILLING_MODE=free
# MODEL_GATEWAY_OPENCODE_GO_BILLING_MODE=subscription

# Generic: replace <PROVIDER> with the UPPERCASED provider name.
# <PROVIDER>_BILLING_MODE=free|paid|subscription
# <PROVIDER>_ACCOUNT_SCOPE=project-id
# <PROVIDER>_FREE_MODELS=model-a:free,model-b
# <PROVIDER>_MODEL_ALLOWLIST=model-a,model-b
# <PROVIDER>_MODEL_DENYLIST=model-c
# <PROVIDER>_ALLOW_MODEL_PASSTHROUGH=true
# <PROVIDER>_ALLOW_INSECURE_HTTP=true
# <PROVIDER>_BASE_URL=https://custom-endpoint.example.com/v1
# <PROVIDER>_API_KEY_SECRET=custom-secret-name
# <PROVIDER>_MAX_IN_FLIGHT=none           # or a non-negative integer
# <PROVIDER>_CONNECT_TIMEOUT_SECONDS=30
# <PROVIDER>_RESPONSE_HEADER_TIMEOUT_SECONDS=30
# <PROVIDER>_STREAM_IDLE_TIMEOUT_SECONDS=300
# <PROVIDER>_EXTRA_HEADERS=X-Header=value,Another=value
# <PROVIDER>_MODEL_MAPPINGS=catalog-model=benchmark-id
# <PROVIDER>_QUOTAS=requests:1000:86400:utc_day;cost_microusd:500000:2592000:utc_month

# Concrete examples:
# MODEL_GATEWAY_OPENROUTER_BILLING_MODE=free
# MODEL_GATEWAY_OPENROUTER_ACCOUNT_SCOPE=project-id
# MODEL_GATEWAY_OPENROUTER_FREE_MODELS=model-a:free,model-b
# MODEL_GATEWAY_OPENROUTER_MODEL_ALLOWLIST=model-a,model-b
# MODEL_GATEWAY_OPENROUTER_MODEL_DENYLIST=model-c
# MODEL_GATEWAY_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# MODEL_GATEWAY_OPENROUTER_QUOTAS=requests:1000:86400:utc_day;cost_microusd:500000:2592000:utc_month
